[nemesis]
version=1.1
id=usbwifi.hotspot
name=USB WiFi dongle as built-in Wi-Fi (KR v4)
type=service,application
package-version=4.13.0
short-desc="T3U dongle as car Wi-Fi for KP, AA keep, no popups, safe logs"
detailed-desc="EV6 KR 4.13: RTL88x2BU driver (GPL-2.0, source inside), wlan0 for Korea Projection. HMG-API mod: AA keep, no plug-in notices, drop logs. Private logs. EXPERIMENTAL RTL8851BU (AX900) driver, untested. Tested on CVEV.KOR 260902."
os="CVEV.KOR*"
models="any"
depends="!jmk-wifi,!jmk.usbwifi,!wireless.projection.usbwifi"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[service.0]
name=usbwifi-dongle
kind=sh
path=svc/dongle.sh
uid=root
mode=restart
