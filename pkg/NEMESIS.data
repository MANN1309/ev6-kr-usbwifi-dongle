[nemesis]
version=1.1
id=usbwifi.hotspot
name=USB WiFi dongle as built-in Wi-Fi (KR v4)
type=service,application
package-version=4.11.1
short-desc="T3U dongle as car Wi-Fi for KP, AA keep, no popups, safe logs"
detailed-desc="EV6 KR 4.11.1: RTL88x2BU driver (GPL-2.0, source inside), dongle as wlan0; Korea Projection runs the hotspot. HMG-API mod ev6-kr-aa-keep: AA keep-connected, no 2 plug-in notices, AA drop logs. Logs leave out personal data. CVEV.KOR 260902."
os="CVEV.KOR.0000.V039.001.260902*"
models="any"
depends="!jmk-wifi,!jmk.usbwifi,!wireless.projection.usbwifi"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[service.0]
name=usbwifi-dongle
kind=sh
path=svc/dongle.sh
uid=root
mode=restart
